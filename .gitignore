# -----------------------------------------------
# AI Meeting Notes Analyzer — .gitignore
# -----------------------------------------------

# Environment — NEVER commit secrets
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# Virtual Environment
venv/
.venv/
env/
ENV/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
*.xml

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Streamlit
.streamlit/

# Database (do not commit generated DB)
db/*.db
db/*.db-journal
db/*.db-wal

# Outputs (generated runtime artifacts)
outputs/*.json

# Audio uploads (temporary, never persist)
data/audio/
*.mp3
*.wav
*.m4a
*.ogg
*.flac
*.webm

# Whisper model cache
~/.cache/whisper/

# Logs
*.log
logs/

# OS
*.DS_Store
