# -----------------------------------------------
# AI Meeting Notes Analyzer — Environment Config
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------

# -----------------------------------------------
# PROVIDER SELECTION
# Options: gemini | openai | claude
# -----------------------------------------------
MODEL_PROVIDER=gemini

# -----------------------------------------------
# API KEYS
# Only the key for the active MODEL_PROVIDER is required.
# Leave unused providers commented out.
# -----------------------------------------------

GEMINI_API_KEY=your_gemini_api_key_here

# OPENAI_API_KEY=your_openai_api_key_here

# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------
# MODEL NAME OVERRIDES (optional)
# Defaults are set per provider in core/config.py
# Uncomment and set only if you need a specific model.
# -----------------------------------------------

# GEMINI_MODEL_NAME=gemini-2.5-flash
# OPENAI_MODEL_NAME=gpt-4o
# CLAUDE_MODEL_NAME=claude-3-5-sonnet-20241022

# -----------------------------------------------
# LLM BEHAVIOR
# Temperature 0.0 = deterministic (required for structured extraction)
# -----------------------------------------------
LLM_TEMPERATURE=0.0

# -----------------------------------------------
# DATABASE
# -----------------------------------------------
DB_PATH=db/meeting_intelligence.db

# -----------------------------------------------
# SPEECH-TO-TEXT
# Options: tiny | base | small | medium | large
# Recommended: base (best speed/accuracy for prototype)
# -----------------------------------------------
WHISPER_MODEL=base

# -----------------------------------------------
# LOGGING
# Options: DEBUG | INFO | WARNING | ERROR
# -----------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------
# OUTPUT
# -----------------------------------------------
OUTPUT_DIR=outputs/
