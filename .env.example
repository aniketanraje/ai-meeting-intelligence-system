# -----------------------------------------------
# AI Meeting Notes Analyzer — Environment Config
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------

# LLM Provider Selection
# Options: gemini | openai | claude
MODEL_PROVIDER=gemini

# Gemini API Key (required if MODEL_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (required if MODEL_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here

# Model name override (optional)
# Default values are set per provider in config.py
# GEMINI_MODEL_NAME=gemini-1.5-pro
# OPENAI_MODEL_NAME=gpt-4o

# LLM Temperature (0.0 = deterministic, recommended for structured extraction)
LLM_TEMPERATURE=0.0

# SQLite database path
DB_PATH=db/meeting_intelligence.db

# Whisper model size
# Options: tiny | base | small | medium | large
# Recommended: base (speed/accuracy balance for prototype)
WHISPER_MODEL=base

# Logging level
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Output directory for JSON exports
OUTPUT_DIR=outputs/
